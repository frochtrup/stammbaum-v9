#!/bin/sh
# .githooks/pre-push — vor jedem Push laufen GENAU die Schritte, die CI ausführt.
# Die Liste steht nicht hier, sondern wird aus .github/workflows/ci.yml gelesen
# (tools/run-ci-steps.mjs erklärt, warum). Notausgang: git push --no-verify
exec node "$(git rev-parse --show-toplevel)/tools/run-ci-steps.mjs"
